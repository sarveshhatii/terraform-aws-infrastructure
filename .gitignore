
# Terraform working directories
**/.terraform/*

# Terraform state files and backups
*.tfstate
*.tfstate.*
**/state-backup.json
state-backup.json

# Terraform execution plans
*.tfplan
*.tfplan.*

# Terraform variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Terraform crash logs
crash.log
crash.*.log

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Credentials and environment files
.env
.env.*
!.env.example
.aws/

# Local bootstrap state files
bootstrap-state/*.tfstate
bootstrap-state/*.tfstate.*
bootstrap-state/*.tfplan
bootstrap-state/*.plan

# Editor and operating-system files
.vscode/
.DS_Store
Thumbs.db
